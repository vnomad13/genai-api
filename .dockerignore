# GPT-2 checkpoints are 480 MB each and unused at runtime.
weights/gpt2_*/
!weights/gpt2_rl_wrapper/
.venv/
data/
.git/
.gitignore
__pycache__/
*.py[cod]
*.egg-info/
.uv/
dist/
build/
*.log
